  "notes": [
    {
      "text": "Hit the pads on your controller, or double-click **Pads** and click them there. Each pad is a **Pad**: its **Gate** strikes its Drum, and its **Vel**, how hard it was struck, goes to that Drum's **Accent**.",
      "position": [
        16.0,
        40.0
      ],
      "width": 380.0
    },
    {
      "text": "Notes the pads hear are theirs: a Note In on Omni lets them be. Pads that send other notes? Right-click **Pads**, choose **Learn in order** and hit them in turn.",
      "position": [
        16.0,
        200.0
      ],
      "width": 380.0
    }
  ],
