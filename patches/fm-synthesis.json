  "notes": [
    {
      "text": "You don't hear the modulator. It bends the carrier's pitch so fast that the bending becomes tone color. Its envelope strikes the bell bright and fades it pure.",
      "position": [
        254.0,
        738.0
      ],
      "width": 380.0
    },
    {
      "text": "The carrier is the one you hear. Its envelope is a bell's: an instant strike and a long ring.",
      "position": [
        801.0,
        738.0
      ],
      "width": 320.0
    }
  ]
