  "notes": [
    {
      "text": "The Clock steps the sequencer once a beat through C D E G A G E D. The pentatonic scale has no half steps, so no two notes clash.",
      "position": [
        223.0,
        565.0
      ],
      "width": 330.0
    },
    {
      "text": "The S&H catches the LFO every third beat, on the Clock Divider, so the brightness moves in threes against the eight-note melody. The cycles don't line up, so no two passes sound alike.",
      "position": [
        16.0,
        1243.0
      ],
      "width": 300.0
    },
    {
      "text": "Noise picks a pitch every few seconds and the Quantizer snaps it to the melody's scale: chance, without a wrong note.",
      "position": [
        479.0,
        1438.0
      ],
      "width": 360.0
    }
  ]
}