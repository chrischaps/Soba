  "notes": [
    {
      "text": "Sixteenths at 112 BPM. The break was played at 96: the **Chopper** starts each slice on its own beat, so it keeps up without going up in pitch.",
      "position": [
        16.0,
        462.0
      ],
      "width": 226.0
    },
    {
      "text": "Each step under the waveform plays a slice, tinted like it. Step 6 plays slice 2 backwards, step 12 plays slice 12 a fourth down, step 14 rests, and step 16 stutters into the top. The dots roll dice. Drag a step up or down to give it another slice, or right-click it for the rest.",
      "position": [
        560.0,
        410.0
      ],
      "width": 386.0
    },
    {
      "text": "A bass line in D minor, in the gaps the break leaves. Its own envelope opens the Ladder on every note.",
      "position": [
        16.0,
        712.0
      ],
      "width": 226.0
    }
  ]
}