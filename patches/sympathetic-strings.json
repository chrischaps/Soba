  "notes": [
    {
      "text": "No oscillators: every note here is a **Resonator**, a string or a glass, rung by a drum or plucked by a lane's gate.",
      "position": [
        16.0,
        470.0
      ],
      "width": 226.0
    },
    {
      "text": "The **Shaker** never stops, so the strings never stop: each bead rings all four strings of the chord at once, the way a drum makes a piano's open strings hum.",
      "position": [
        16.0,
        1140.0
      ],
      "width": 226.0
    },
    {
      "text": "The **Rim** strikes a glass tuned to E5. Turn its **Material** to Bell or Wood, or the glass's **Inharm**, and the same rim plays a different instrument.",
      "position": [
        16.0,
        590.0
      ],
      "width": 226.0
    }
  ]
}
