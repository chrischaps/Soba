  "notes": [
    {
      "text": "Each chord gets half a bar of eighth notes: a downstroke held over the next clock, then down, up. With **Strum dir** on Alt the hand turns on every clock, held or not, so the downstrokes stay on the beat and the upstrokes on the offbeats.",
      "position": [
        640.0,
        584.0
      ],
      "width": 400.0
    },
    {
      "text": "**Strum** 25 ms rolls each chord from the bass string up on a downstroke, and from the top string down on an upstroke. **Taper** 40% softens the strings struck last, so an upstroke only brushes the bass.",
      "position": [
        1070.0,
        584.0
      ],
      "width": 400.0
    }
  ],
