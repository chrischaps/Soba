  "notes": [
    {
      "text": "A saw wave holds every harmonic, so it's the richest thing to carve with a filter.",
      "position": [
        16.0,
        666.0
      ],
      "width": 300.0
    },
    {
      "text": "The filter envelope opens the cutoff an octave on every note, then lets it settle: that's the pluck. Turn **Res** up slowly and listen for the whistle.",
      "position": [
        540.0,
        828.0
      ],
      "width": 280.0
    },
    {
      "text": "One gate starts both envelopes. This one shapes the volume, and falls more slowly than the tone.",
      "position": [
        842.0,
        738.0
      ],
      "width": 280.0
    }
  ]
