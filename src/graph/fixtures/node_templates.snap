== osc.sine "Oscillator" finder="Oscillator" Source
in   V/Oct              Control  ConnectionOnly       inline=true  port
in   FM                 Control  ConnectionOnly       inline=true  port
in   Exp FM             Control  ConnectionOnly       inline=true  port
in   PWM                Control  ConnectionOnly       inline=true  port
in   Sync               Control  ConnectionOnly       inline=true  port
in   Octave             Control  ConstantOnly         inline=false num 0 [-4..4] oct stepped
in   Semitone           Control  ConstantOnly         inline=false num 0 [-12..12] st stepped
in   Fine               Control  ConstantOnly         inline=false num 0 [-100..100] ct
in   FM Depth           Control  ConstantOnly         inline=false num 0 [0..5]
in   Exp FM Depth       Control  ConstantOnly         inline=false num 1 [0..4] oct
in   Waveform           Control  ConstantOnly         inline=true  select 0 ["Sine", "Saw", "Square", "Tri"] "Wave"
in   Pulse Width        Control  ConstantOnly         inline=false num 0.5 [0.1..0.9]
in   Voices             Control  ConstantOnly         inline=false num 1 [1..7]  stepped
in   Detune             Control  ConstantOnly         inline=false num 0.4 [0..1] %
in   Spread             Control  ConstantOnly         inline=false num 0.5 [0..1] %
out  Out                Audio
out  Sub                Audio
out  Out L              Audio
out  Out R              Audio
knob Octave             "Oct" KnobOnly
knob Semitone           "Semi" KnobOnly
knob Fine               "Fine" KnobOnly
knob FM Depth           "FM" KnobOnly
knob Exp FM Depth       "Exp FM" KnobOnly
knob Pulse Width        "PW" KnobOnly
knob Voices             "Voices" KnobOnly
knob Detune             "Detune" KnobOnly
knob Spread             "Spread" KnobOnly
display OscillatorWave

== source.noise "Noise" finder="Noise" Source
in   Level              Control  ConnectionOrConstant inline=true  num 0.5 [0..1]
in   Rate               Control  ConnectionOrConstant inline=true  num 1 [0.01..20] Hz log
out  White              Audio
out  Pink               Audio
out  Brown              Audio
out  Random             Control
out  Dust               Gate
knob Level              "Level" Modulatable
knob Rate               "Rate" Modulatable
display NoiseSpectrum

== source.drum "Drum" finder="Drum" Source
in   Trig               Gate     ConnectionOnly       inline=true  port
in   Accent             Control  ConnectionOnly       inline=true  port
in   Choke              Gate     ConnectionOnly       inline=true  port
in   Type               Control  ConstantOnly         inline=true  select 0 ["Kick", "Snare", "Tom", "Clap", "Closed Hat", "Open Hat", "Cymbal", "Rim", "Cowbell", "Shaker"] "Type"
in   Tune               Control  ConnectionOrConstant inline=true  num 0 [-24..24] st
in   Decay              Control  ConnectionOrConstant inline=true  num 0.5 [0..1] %
in   Tone               Control  ConstantOnly         inline=false num 0.5 [0..1] %
in   Snap               Control  ConstantOnly         inline=false num 0.5 [0..1] %
in   Level              Control  ConstantOnly         inline=false num 0.8 [0..1]
out  Out                Audio
knob Tune               "Tune" Modulatable
knob Decay              "Decay" Modulatable
knob Tone               "Tone" KnobOnly
knob Snap               "Snap" KnobOnly
knob Level              "Level" KnobOnly
display DrumHit

== source.resonator "Resonator" finder="Resonator" Source
in   Gate               Gate     ConnectionOnly       inline=true  port
in   V/Oct              Control  ConnectionOnly       inline=true  port
in   Strike             Control  ConnectionOnly       inline=true  port
in   In                 Audio    ConnectionOnly       inline=true  port
in   Mode               Control  ConstantOnly         inline=true  select 0 ["String", "Body"] "Mode"
in   Material           Control  ConstantOnly         inline=true  select 0 ["Bell", "Bar", "Glass", "Wood"] "Material"
in   Decay              Control  ConnectionOrConstant inline=true  num 0.6 [0..1] %
in   Damping            Control  ConnectionOrConstant inline=true  num 0.4 [0..1] %
in   Brightness         Control  ConnectionOrConstant inline=true  num 0.6 [0..1] %
in   Tune               Control  ConstantOnly         inline=false num 0 [-24..24] st
in   Position           Control  ConstantOnly         inline=false num 0.3 [0..1] %
in   Inharm             Control  ConstantOnly         inline=false num 0.5 [0..1] %
in   Level              Control  ConstantOnly         inline=false num 0.8 [0..1]
out  Out                Audio
knob Tune               "Tune" KnobOnly
knob Decay              "Decay" Modulatable
knob Damping            "Damp" Modulatable
knob Brightness         "Bright" Modulatable
knob Position           "Pos" KnobOnly
knob Inharm             "Inharm" KnobOnly
knob Level              "Level" KnobOnly
display ResonatorRings

== source.sampler "Sampler" finder="Sampler" Source
in   Gate               Gate     ConnectionOnly       inline=true  port
in   V/Oct              Control  ConnectionOnly       inline=true  port
in   Velocity           Control  ConnectionOnly       inline=true  port
in   Start              Control  ConnectionOrConstant inline=true  num 0 [0..1] %
in   Speed              Control  ConnectionOrConstant inline=true  num 1 [-2..2] x
in   Slice              Control  ConnectionOnly       inline=true  port
in   In L               Audio    ConnectionOnly       inline=true  port
in   In R               Audio    ConnectionOnly       inline=true  port
in   Rec                Gate     ConnectionOnly       inline=true  port
in   Loop               Control  ConstantOnly         inline=true  select 0 ["Off", "Forward", "Ping-Pong"] "Loop"
in   Mode               Control  ConstantOnly         inline=true  select 0 ["One-Shot", "Gated"] "Mode"
in   Take               Control  ConstantOnly         inline=true  select 0 ["Free", "1 bar", "2 bars", "4 bars", "8 bars", "16 bars"] "Take"
in   End                Control  ConstantOnly         inline=false num 1 [0..1] %
in   Loop Start         Control  ConstantOnly         inline=false num 0 [0..1] %
in   Loop End           Control  ConstantOnly         inline=false num 1 [0..1] %
in   Tune               Control  ConstantOnly         inline=false num 0 [-24..24] st stepped
in   Fine               Control  ConstantOnly         inline=false num 0 [-100..100] ct
in   Root               Control  ConstantOnly         inline=false num 60 [0..127] note stepped
in   Attack             Control  ConstantOnly         inline=false num 0.002 [0.001..2] s log
in   Release            Control  ConstantOnly         inline=false num 0.01 [0.001..5] s log
in   Level              Control  ConstantOnly         inline=false num 0.8 [0..1]
in   Slices             Control  ConstantOnly         inline=false num 1 [1..65] slices stepped
in   Rec Threshold      Control  ConstantOnly         inline=false num -60 [-60..0] dB
in   Rec Button         Control  ConstantOnly         inline=false toggle false ""
in   Sensitivity        Control  ConstantOnly         inline=false num 0.5 [0..1] %
in   Tidy Takes         Control  ConstantOnly         inline=false toggle false ""
out  L                  Audio
out  R                  Audio
knob Start              "Start" Modulatable
knob End                "End" KnobOnly
knob Loop Start         "Lp St" KnobOnly
knob Loop End           "Lp End" KnobOnly
knob Slices             "Slices" KnobOnly
knob Root               "Root" KnobOnly
knob Tune               "Tune" KnobOnly
knob Fine               "Fine" KnobOnly
knob Speed              "Speed" Modulatable
knob Attack             "Atk" KnobOnly
knob Release            "Rel" KnobOnly
knob Level              "Level" KnobOnly
knob Rec Threshold      "Thresh" KnobOnly
knob Sensitivity        "Sens" KnobOnly
display SamplerWave

