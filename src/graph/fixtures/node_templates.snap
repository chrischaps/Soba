== seq.chord "Chord Sequencer" finder="Chord Sequencer" Utility
in   Clock              Gate     ConnectionOnly       inline=true  port
in   Reset              Gate     ConnectionOnly       inline=true  port
in   Run                Gate     ConnectionOnly       inline=true  port
in   Pattern            Control  ConnectionOnly       inline=true  port
in   Steps              Control  ConstantOnly         inline=false num 4 [1..16]  stepped
in   Direction          Control  ConstantOnly         inline=true  select 0 ["Fwd", "Bwd", "P-P", "Rnd"] "Dir"
in   Gate Length        Control  ConstantOnly         inline=false num 100 [1..100] %
in   Voicing            Control  ConstantOnly         inline=true  select 0 ["Close", "Open", "Spread"] "Voicing"
in   Voice Leading      Control  ConstantOnly         inline=true  toggle true "Voice lead"
in   Voices             Control  ConstantOnly         inline=false num 4 [1..8]  stepped
in   Range              Control  ConstantOnly         inline=false num 3 [1..6]  stepped
in   Bass Voice         Control  ConstantOnly         inline=true  toggle false "Bass voice"
in   Rootless           Control  ConstantOnly         inline=true  toggle false "Rootless"
in   Strum              Control  ConstantOnly         inline=false num 0 [0..100] ms
in   Strum Dir          Control  ConstantOnly         inline=true  select 0 ["Up", "Down", "Alt"] "Strum dir"
in   Strum Taper        Control  ConstantOnly         inline=false num 0 [-100..100] %
in   Step 1 Root        Control  ConstantOnly         inline=false num 36 [0..127]  stepped
in   Step 1 Type        Control  ConstantOnly         inline=false select 3 ["maj", "min", "7", "maj7", "m7", "m7b5", "dim", "aug", "sus2", "sus4", "6", "m6", "add9", "maj9", "m9", "9", "11", "13", "madd9"] ""
in   Step 1 Bass        Control  ConstantOnly         inline=false select 0 ["Root", "C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"] ""
in   Step 1 Gate        Control  ConstantOnly         inline=false toggle true ""
in   Step 1 Velocity    Control  ConstantOnly         inline=false num 100 [0..127]  stepped
in   Step 1 Tie         Control  ConstantOnly         inline=false toggle false ""
in   Step 1 Top         Control  ConstantOnly         inline=false select 0 ["Auto", "C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"] ""
in   Step 1 Strum       Control  ConstantOnly         inline=false select 0 ["Auto", "Up", "Down"] ""
in   Step 2 Root        Control  ConstantOnly         inline=false num 33 [0..127]  stepped
in   Step 2 Type        Control  ConstantOnly         inline=false select 4 ["maj", "min", "7", "maj7", "m7", "m7b5", "dim", "aug", "sus2", "sus4", "6", "m6", "add9", "maj9", "m9", "9", "11", "13", "madd9"] ""
in   Step 2 Bass        Control  ConstantOnly         inline=false select 0 ["Root", "C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"] ""
in   Step 2 Gate        Control  ConstantOnly         inline=false toggle true ""
in   Step 2 Velocity    Control  ConstantOnly         inline=false num 100 [0..127]  stepped
in   Step 2 Tie         Control  ConstantOnly         inline=false toggle false ""
in   Step 2 Top         Control  ConstantOnly         inline=false select 0 ["Auto", "C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"] ""
in   Step 2 Strum       Control  ConstantOnly         inline=false select 0 ["Auto", "Up", "Down"] ""
in   Step 3 Root        Control  ConstantOnly         inline=false num 29 [0..127]  stepped
in   Step 3 Type        Control  ConstantOnly         inline=false select 3 ["maj", "min", "7", "maj7", "m7", "m7b5", "dim", "aug", "sus2", "sus4", "6", "m6", "add9", "maj9", "m9", "9", "11", "13", "madd9"] ""
in   Step 3 Bass        Control  ConstantOnly         inline=false select 0 ["Root", "C", "Db", "D", "Eb", "E", "F", "F#", "G", "Ab", "A", "Bb", "B"] ""
in   Step 3 Gate        Control  ConstantOnly         inline=false toggle true ""
in   Step 3 Velocity    Control  ConstantOnly         inline=false num 100 [0..127]  stepped
